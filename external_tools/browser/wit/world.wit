package sat:browser@0.1.0;

/// Transport only: the host chooses the destination from an explicit grant.
interface connection {
    exchange: func(message: string) -> result<string, string>;
    poll: func(milliseconds: u32) -> result<string, string>;
}

world browser {
    import connection;
    export run: func(action: string, target: option<string>, value: option<string>,
        tab: option<string>, output: option<string>, timeout: u32) -> result<string, string>;
}

package local:fff-fuzzy@0.1.0;

interface search {
    /// Half-open UTF-8 byte range within the original candidate string.
    record highlight {
        start: u32,
        end: u32,
    }

    record hit {
        /// Zero-based index in the most recent set-candidates call.
        id: u32,
        /// Higher scores rank first; ties retain candidate order.
        score: u16,
        highlights: list<highlight>,
    }

    /// Single-call convenience API for Wasmtime CLI invocation.
    match-paths: func(paths: list<string>, query: string, limit: u32, max-typos: u16)
        -> result<list<hit>, string>;

    resource finder {
        constructor();
        /// Atomically replace all candidates. IDs are reset on success.
        set-candidates: func(paths: list<string>) -> result<_, string>;
        /// Empty queries return candidates in input order with score zero.
        /// max-typos is the allowed number of missing query characters (0..2).
        search: func(query: string, limit: u32, max-typos: u16)
            -> result<list<hit>, string>;
    }
}

/// Deliberately no imports: no filesystem, clocks, randomness, or network.
world fuzzy-finder {
    export search;
    /// Stateless CLI entrypoint: newline-separated candidates, ranked matching strings.
    export match-candidates: func(candidates: string, query: string, limit: u32, max-typos: u16) -> result<list<string>, string>;
}

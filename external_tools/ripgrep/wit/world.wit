package sat:ripgrep@0.1.0;

world ripgrep {
    // Files are opened through standard WASI filesystem imports generated by
    // Rust's wasip2 target. Only the host can supply filesystem capabilities.
    // Return text or JSON through WIT; guest stdout is never the result transport.
    export run: func(
        pattern: string,
        path: option<list<string>>,
        ignore-case: bool,
        fixed-strings: bool,
        hidden: bool,
        no-ignore: bool,
        context: u32,
        max-results: u32,
        format: string,
    ) -> result<string, string>;
}

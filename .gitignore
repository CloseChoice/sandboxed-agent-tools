**/*.rs.bk

# Rust profiling and coverage output
*.profraw
*.profdata

# Keep Cargo.lock files tracked for reproducible builds.

# Project-local toolchains and generated Wasm artifacts
.toolchain/
dist/

# Local editor logs
nvim.log

# Local credentials and development environments
keys.md
.env
.env.*
!.env.example
.venv/
venv/
node_modules/
__pycache__/
*.py[cod]
*.egg-info/
build/
.ipynb_checkpoints/

# Local document inputs; keep only the fictional, reproducible walkthrough.
/data/*
!/data/signature-workflow/

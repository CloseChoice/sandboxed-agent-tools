# Rust build output (including nested crates such as cli/)
target/

# Backup files generated by rustfmt
**/*.rs.bk

# Rust profiling and coverage output
*.profraw
*.profdata

# Keep Cargo.lock files tracked for reproducible builds.

# Project-local toolchains and generated Wasm artifacts
.toolchain/
dist/

# Local editor logs
nvim.log

# Python test bytecode
__pycache__/

# tar/zip
*.zip
*.tar
*.tar.gz

# Local credentials, sample inputs, agent logs, and research checkouts
/keys.md
/data/
/codex/
/experiments/
/repos/

# Generated JavaScript dependencies and test reports
node_modules/
test-results/

# Generated Python packaging probes
/python-venv-test-package/
*.egg-info/
